# Copy this file to .env.prod on the VPS (never commit the real file — see .gitignore)
# and fill in real values. The app currently runs on in-memory demo data with no
# database, so this list is short; it grows as T-046/T-047 (real PostgreSQL persistence)
# land.

# Comma-separated list of origins allowed to call the API cross-origin. This deployment
# uses two subdomains (frontend and backend on separate origins), so this is genuinely
# needed — it must be the frontend's real HTTPS origin, not localhost.
ALLOWED_ORIGINS=https://fintrix.adityajagtap.com
