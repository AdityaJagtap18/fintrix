# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Env / secrets
.env
*.local.env
.env.*
!.env.example

# Azure / Bicep
*.bicepparam.local

# Node / React (src/web)
src/web/node_modules/
src/web/dist/
src/web/.vite/

# Responsive QA evidence (regenerated by the scripts in src/web/responsive-qa;
# screenshots/reports are run artifacts, and .auth holds a throwaway dev session
# token — none of it belongs in version control).
src/web/responsive-qa/screenshots/
src/web/responsive-qa/reports/
src/web/responsive-qa/.auth/

# IDE
.vscode/
.idea/
.claude/
*.swp

# OS
.DS_Store

# Data / artifacts (never commit real invoices or extracted data)
tests/golden/private/
*.pdf
!docs/**/*.pdf
# A generated, content-free blank page used only to exercise the review workspace's PDF
# viewer in dev — not a real or sample invoice.
!src/web/public/*.pdf
data/raw/
data/analyzed/
