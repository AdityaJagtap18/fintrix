# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Env / secrets
.env
*.local.env
.env.*
!.env.example

# Azure / Bicep
*.bicepparam.local

# Node / React (src/web)
src/web/node_modules/
src/web/dist/
src/web/.vite/

# IDE
.vscode/
.idea/
.claude/
*.swp

# OS
.DS_Store

# Data / artifacts (never commit real invoices or extracted data)
tests/golden/private/
*.pdf
!docs/**/*.pdf
# Synthetic test fixtures only (scripts/generate_sample_invoices.py) — no real invoice ever
# belongs here, this rule exists specifically to keep that true.
!src/web/public/sample-invoice.pdf
!src/web/public/sample-invoices/*.pdf
data/raw/
data/analyzed/
