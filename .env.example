# Copy to .env and fill in once Phase 2 infra exists. Phase 0/1 (`make setup`, `make test`)
# need none of this — src/core has no cloud dependency by design (Article I).

# --- Azure identity (federated OIDC locally via `az login`, Managed Identity in Azure) ---
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=

# --- Document Intelligence (Phase 2) ---
DOCUMENT_INTELLIGENCE_ENDPOINT=
# No key here on purpose — disableLocalAuth: true, auth is via Managed Identity / az login.

# --- Storage (Phase 2) ---
STORAGE_ACCOUNT_URL=
BLOB_CONTAINER_RAW=raw
BLOB_CONTAINER_ANALYZED=analyzed
BLOB_CONTAINER_QUARANTINE=quarantine
BLOB_CONTAINER_FEEDBACK=feedback
BLOB_CONTAINER_TRAINING=training

# --- Service Bus (Phase 2) ---
SERVICE_BUS_NAMESPACE=
SERVICE_BUS_QUEUE_EXTRACT=invoice-extract
SERVICE_BUS_QUEUE_REVIEW=invoice-review
SERVICE_BUS_QUEUE_ERP_POST=erp-post

# --- Azure SQL (Phase 2) ---
SQL_SERVER=
SQL_DATABASE=

# --- Azure OpenAI (Phase 3, exception explanations only — never in the decision path) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# --- Azure Communication Services (Phase 3b, WhatsApp intake) ---
ACS_ENDPOINT=
ACS_WHATSAPP_CHANNEL_ID=

# --- App Insights (Phase 2) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Routing defaults (overridable per vendor in SQL once Phase 2 lands) ---
ROUTING_AUTO_THRESHOLD=0.92
ROUTING_REVIEW_THRESHOLD=0.70
ROUTING_LINE_THRESHOLD=0.80
ROUTING_MIN_VENDOR_HISTORY=1
ROUTING_SHADOW_MODE_DEFAULT=true
