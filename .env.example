# Copy to .env and fill in once Phase 2 infra exists. Phase 0/1 (`make setup`, `make test`)
# need none of this — src/core has no cloud dependency by design (Article I).

# --- Azure identity (federated OIDC locally via `az login`, Managed Identity in Azure) ---
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
# Local-dev-only fallback when neither `az login` nor Managed Identity is available (e.g.
# a tenant that blocks unconsented public-client apps, so azure-cli's device-code flow
# can't be used either). Set together with AZURE_CLIENT_ID to authenticate as an app
# registration via ClientSecretCredential instead — see scripts/azure_login.py's docstring
# and api/dependencies.py's get_azure_credential(). Never commit a real value; .gitignore
# already excludes .env itself.
AZURE_CLIENT_SECRET=

# --- Document Intelligence (Phase 2) ---
DOCUMENT_INTELLIGENCE_ENDPOINT=
# No key here on purpose — disableLocalAuth: true, auth is via Managed Identity / az login.

# --- Storage (Phase 2) ---
STORAGE_ACCOUNT_URL=
BLOB_CONTAINER_RAW=raw
BLOB_CONTAINER_ANALYZED=analyzed
BLOB_CONTAINER_QUARANTINE=quarantine
BLOB_CONTAINER_FEEDBACK=feedback
BLOB_CONTAINER_TRAINING=training

# --- Service Bus (Phase 2) ---
SERVICE_BUS_NAMESPACE=
SERVICE_BUS_QUEUE_EXTRACT=invoice-extract
SERVICE_BUS_QUEUE_REVIEW=invoice-review
SERVICE_BUS_QUEUE_ERP_POST=erp-post

# --- Cosmos DB (Phase 2) --- no keys: Entra RBAC only (Article III), same
# DefaultAzureCredential/get_azure_credential() path as everything else.
COSMOS_ENDPOINT=
COSMOS_DATABASE=

# --- Azure OpenAI (Phase 3, exception explanations only — never in the decision path) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# --- Azure Communication Services (Phase 3b, WhatsApp intake) ---
ACS_ENDPOINT=
ACS_WHATSAPP_CHANNEL_ID=

# --- App Insights (Phase 2) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
# ₹/page rate for the Preprocessing page's cost estimate (api/observability.py). Omit to
# leave the estimate blank rather than ship a guessed number.
DOCUMENT_INTELLIGENCE_COST_PER_PAGE=

# --- Routing defaults (overridable per vendor in Cosmos DB once Phase 2 lands) ---
ROUTING_AUTO_THRESHOLD=0.92
ROUTING_REVIEW_THRESHOLD=0.70
ROUTING_LINE_THRESHOLD=0.80
ROUTING_MIN_VENDOR_HISTORY=1
ROUTING_SHADOW_MODE_DEFAULT=true

# --- AP/Admin login — gates the Review flow (claim/submit), GET /processing/results/
# rejected, and every /admin endpoint (forwarded queue, accept, export). Real named
# users, not one shared credential — see api/auth.py's docstring. Credentials live in a
# spreadsheet, not here: point this at it if it's not at the default data/credentials.xlsx,
# and manage users with `PYTHONPATH=src .venv/bin/python scripts/manage_credentials.py
# add --username <name> --role ap|admin` (prompts for the password, never takes it as a
# CLI arg or writes it in plaintext). Login refuses every attempt while the file doesn't
# exist or has no matching row.
CREDENTIALS_XLSX_PATH=
